.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Typescript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Secrets: never commit these. API keys (e.g. GROQ_API_KEY) live in
# Netlify → Environment variables, not in the repo.
.env
.env.*
!.env.example
# Netlify CLI local state (can hold linked-site info and cached env vars)
.netlify/

# Old Gatsby cache (public/ now holds real static files: keep it tracked)
.cache/

# Mac files
.DS_Store

# Yarn
yarn-error.log
.pnp/
.pnp.js
