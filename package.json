{
  "name": "jonathanhelvey-portfolio",
  "private": true,
  "version": "2.0.0",
  "description": "Jonathan Helvey's portfolio \u2014 React + Vite, pre-rendered to static HTML.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.jsx --outDir dist/server && node scripts/prerender.js",
    "preview": "vite preview --outDir dist/client",
    "audit": "pnpm audit --audit-level=moderate",
    "test": "node --test tests/*.test.mjs",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/playfair-display": "5.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "marked": "18.0.14",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "vite": "8.3.1"
  }
}
